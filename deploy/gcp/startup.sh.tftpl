#!/usr/bin/env bash
set -euo pipefail
exec > >(tee -a /var/log/lean-report-card-startup.log | logger -t lean-report-card-startup) 2>&1

export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y ca-certificates curl git jq docker.io docker-compose-v2
systemctl enable --now docker

DATA_DEVICE=/dev/disk/by-id/google-lrc-data
DATA_ROOT=/srv/lean-report-card
mkdir -p "$DATA_ROOT"
if ! blkid "$DATA_DEVICE" >/dev/null 2>&1; then
  mkfs.ext4 -F "$DATA_DEVICE"
fi
if ! mountpoint -q "$DATA_ROOT"; then
  mount "$DATA_DEVICE" "$DATA_ROOT"
fi
grep -q " $DATA_ROOT " /etc/fstab || echo "$DATA_DEVICE $DATA_ROOT ext4 defaults,nofail 0 2" >> /etc/fstab

mkdir -p "$DATA_ROOT/docker"
cat >/etc/docker/daemon.json <<JSON
{
  "data-root": "$DATA_ROOT/docker",
  "log-driver": "json-file",
  "log-opts": {"max-size": "20m", "max-file": "5"},
  "live-restore": true
}
JSON
systemctl restart docker

TOKEN="$(curl -fsS -H 'Metadata-Flavor: Google' \
  http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token | jq -r .access_token)"
secret_value() {
  local secret_name="$1"
  curl -fsS -H "Authorization: Bearer $TOKEN" \
    "https://secretmanager.googleapis.com/v1/projects/${project_id}/secrets/$secret_name/versions/latest:access" \
    | jq -r .payload.data | base64 -d
}

DB_PASSWORD="$(secret_value '${database_secret_name}')"
APP_SECRET="$(secret_value '${application_secret_name}')"
GITHUB_TOKEN=""
if [ -n '${github_token_secret_name}' ]; then
  GITHUB_TOKEN="$(secret_value '${github_token_secret_name}')"
fi

APP_DIR=/opt/lean-report-card
if [ ! -d "$APP_DIR/.git" ]; then
  rm -rf "$APP_DIR"
  git clone '${app_repo_url}' "$APP_DIR"
fi
git -C "$APP_DIR" remote set-url origin '${app_repo_url}'
git -C "$APP_DIR" fetch --force --tags --prune origin '${app_git_ref}'
git -C "$APP_DIR" checkout --force --detach FETCH_HEAD
git -C "$APP_DIR" submodule update --init --recursive || true

cat >"$APP_DIR/.env" <<ENV
LRC_ENVIRONMENT=production
LRC_PUBLIC_BASE_URL=http://${public_ip}
LRC_SECRET_KEY=$APP_SECRET
POSTGRES_PASSWORD=$DB_PASSWORD
LRC_DATABASE_URL=postgresql+psycopg://lrc:$DB_PASSWORD@db:5432/lrc
LRC_REDIS_URL=redis://redis:6379/0
LRC_ANALYZER_VERSION=0.1.0
LRC_RUNNER_IMAGE=lean-report-card-runner:local
LRC_RUNNER_MODE=docker
LRC_GITHUB_TOKEN=$GITHUB_TOKEN
LRC_BIG_REPO_THRESHOLD_KIB=100000
LRC_KNOWN_BIG_REPOS=leanprover-community/mathlib4,leanprover/lean4
LRC_SMALL_TIMEOUT_SECONDS=1800
LRC_BIG_TIMEOUT_SECONDS=7200
LRC_SMALL_MEMORY=4g
LRC_BIG_MEMORY=12g
LRC_SMALL_CPUS=2.0
LRC_BIG_CPUS=6.0
LRC_SMALL_LEAN_THREADS=2
LRC_BIG_LEAN_THREADS=6
LRC_RUNNER_NETWORK_MODE=bridge
SITE_ADDRESS=:80
ENV
chmod 600 "$APP_DIR/.env"

cd "$APP_DIR"
docker compose -f docker-compose.yml -f deploy/gcp/docker-compose.gcp.yml up -d --build --remove-orphans

if ! dpkg -s google-cloud-ops-agent >/dev/null 2>&1; then
  curl -fsSLO https://dl.google.com/cloudagents/add-google-cloud-ops-agent-repo.sh
  bash add-google-cloud-ops-agent-repo.sh --also-install
  rm -f add-google-cloud-ops-agent-repo.sh
fi
cp "$APP_DIR/deploy/gcp/ops-agent.yaml" /etc/google-cloud-ops-agent/config.yaml
systemctl restart google-cloud-ops-agent
