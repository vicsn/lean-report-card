# Application
LRC_ENVIRONMENT=development
LRC_PUBLIC_BASE_URL=http://localhost
LRC_SECRET_KEY=replace-me
LRC_DATABASE_URL=postgresql+psycopg://lrc:lrc@db:5432/lrc
LRC_REDIS_URL=redis://redis:6379/0
LRC_ANALYZER_VERSION=0.1.0
LRC_RUNNER_IMAGE=lean-report-card-runner:local
LRC_RUNNER_MODE=docker
LRC_GITHUB_TOKEN=

# Queue selection. GitHub reports repository size in KiB.
LRC_BIG_REPO_THRESHOLD_KIB=100000
LRC_KNOWN_BIG_REPOS=leanprover-community/mathlib4,leanprover/lean4

# Sandboxed runner budgets.
LRC_SMALL_TIMEOUT_SECONDS=1800
LRC_BIG_TIMEOUT_SECONDS=7200
LRC_SMALL_MEMORY=4g
LRC_BIG_MEMORY=12g
LRC_SMALL_CPUS=2.0
LRC_BIG_CPUS=6.0
LRC_SMALL_LEAN_THREADS=2
LRC_BIG_LEAN_THREADS=6
LRC_MAX_LOG_BYTES=1000000
LRC_RUNNER_NETWORK_MODE=bridge
LRC_ELAN_CACHE_VOLUME=lrc_elan_cache
LRC_LAKE_CACHE_VOLUME=lrc_lake_cache

# Caddy listens on plain HTTP locally. Set to a real domain after DNS is ready.
SITE_ADDRESS=:80
